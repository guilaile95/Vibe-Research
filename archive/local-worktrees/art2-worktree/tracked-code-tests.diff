+def _canonical_cash_effective_at(value: object) -> str | None:
+    """将用户明确声明的带时区时间规范化为 canonical UTC；空值表示未声明。"""
+    if value is None:
+        return None
+    if not isinstance(value, str) or not value.strip():
+        raise ValueError("cash_effective_at 必须是带时区的 ISO 8601 时间或 null")
+    text = value.strip()
+    if not _CASH_EFFECTIVE_AT_RE.fullmatch(text):
+        raise ValueError("cash_effective_at 必须是带时区的 ISO 8601 时间")
+    try:
+        parsed = datetime.fromisoformat(text.replace("Z", "+00:00"))
+    except ValueError as exc:
+        raise ValueError("cash_effective_at 不是合法时间") from exc
+    if parsed.tzinfo is None or parsed.utcoffset() is None:
+        raise ValueError("cash_effective_at 必须包含时区偏移")
+    return parsed.astimezone(timezone.utc).isoformat(timespec="microseconds").replace("+00:00", "Z")
+
